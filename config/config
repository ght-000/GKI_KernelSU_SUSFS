# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=true

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=a0ac906915c8a8d50d474dfb3cae478ef32edc1a
gki-android15-6.6=
gki-android16-6.12=

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=1cfa57340590971cba7521ed536da8ebbedc5f0a
# Manager APK source commit. Keep this on main: the latest main kernel API is
# not compatible with the GKI/SUSFS inline hooks used by this build target.
sukisu_manager=8ed5bd556fba073d52f4a4d98500b782db6437e6
